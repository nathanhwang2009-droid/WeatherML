{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git Pull",
      "type": "shell",
      "command": "git pull",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "UV Sync (Install Dependencies)",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
